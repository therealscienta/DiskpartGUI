<Window x:Class="DiskpartGUI.Views.Dialogs.WipeDiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DiskpartGUI.Converters"
        Title="Wipe Disk"
        Width="480"
        SizeToContent="Height"
        Background="#16213E"
        Foreground="#ECF0F1"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Wipe Disk" FontSize="16" FontWeight="SemiBold"
                   Foreground="#E74C3C" Margin="0,0,0,16"/>

        <TextBlock Text="{Binding DiskDescription}" Foreground="#ECF0F1"
                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <TextBlock Text="These partitions will be removed:" Foreground="#95A5A6" FontSize="12"
                   Margin="0,0,0,4"
                   Visibility="{Binding HasPartitions, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding PartitionSummaries}" Margin="12,0,0,12"
                      Visibility="{Binding HasPartitions, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="#ECF0F1" FontSize="12"
                               Margin="0,1" TextWrapping="Wrap"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="This disk has no partitions." Foreground="#95A5A6" FontSize="12"
                   Margin="0,0,0,12"
                   Visibility="{Binding HasPartitions, Converter={StaticResource InverseBoolToVis}}"/>

        <Border Background="#2C1F1F" BorderBrush="#E74C3C" BorderThickness="1"
                CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="{Binding WarningMessage}" Foreground="#E74C3C"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <CheckBox IsChecked="{Binding Confirmed, Mode=TwoWay}" Foreground="#ECF0F1" FontSize="12">
            <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap"/>
        </CheckBox>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource PrimaryButtonStyle}"
                    Background="#34495E" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Wipe Disk" Style="{StaticResource DangerButtonStyle}"
                    IsEnabled="{Binding CanConfirm}" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
